// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// NOTE: The datasource is currently SQLite for local development.
// To switch to MySQL later, change the datasource below to:
//   provider = "mysql"
//   url      = env("DATABASE_URL")
// and update DATABASE_URL in .env (e.g. mysql://user:pass@localhost:3306/db).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// How often a recurring expense repeats.
enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

/// A single expense entry. When `frequency` is null the expense is one-time;
/// otherwise it repeats starting on `date` at the given frequency. For
/// recurring expenses `amount` holds the current charge amount, while the
/// point-in-time history lives in `RecurringAmount`.
model Expense {
  id        String            @id @default(cuid())
  title     String
  amount    Float
  category  String?
  date      DateTime
  frequency Frequency?
  amounts   RecurringAmount[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

/// A point-in-time amount for a recurring expense. The amount in effect for a
/// given occurrence date is the latest row whose `effectiveFrom` is on or
/// before that date (falling back to the earliest row for backfilled dates).
model RecurringAmount {
  id            String   @id @default(cuid())
  expenseId     String
  expense       Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  amount        Float
  effectiveFrom DateTime
  createdAt     DateTime @default(now())

  @@index([expenseId, effectiveFrom])
}

/// The user's budget for a specific calendar month, keyed by `month` ("YYYY-MM").
/// Changing the budget for one month never affects other months.
model Budget {
  id        String   @id @default(cuid())
  month     String   @unique
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A registered user account. Accounts are created by signing in with Google.
model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  image     String?
  googleId  String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sessions  Session[]
}

/// A server-side login session. The cookie stores the raw token while the
/// database stores only its SHA-256 hash, so a leaked DB row can't be replayed.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
